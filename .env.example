# 服务访问地址（无域名场景可直接填公网 IP + 端口）
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8080

# 鉴权
JWT_SECRET=replace-with-long-random-string
ADMIN_KEY=replace-with-admin-key

# 阿里模型（无 key 时可 MOCK_MODE=true）
ALI_MODEL_ENDPOINT=
ALI_API_KEY=
ALI_VLM_MODEL=qwen-vl-plus
ALI_DISABLE_THINKING=true
ALI_REQUEST_TIMEOUT_MS=60000
ALI_MAX_TOKENS=2000

# OpenClaw / PPT Skill
OPENCLAW_BASE_URL=http://openclaw:3000
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_PPT_TOOL=skills_run
OPENCLAW_PPT_TOOL_ARG_SKILL_KEY=skill
PPT_SKILL=ide-rea/ai-ppt-generator

# 强制 mock（推荐在无外部 key 时开启）
MOCK_MODE=true
